{
  "name": "dumbchess-stockfish-gui",
  "version": "1.0.0",
  "description": "A simple online multiplayer chess game",
  "main": "server.js",
  "scripts": {
    "dev": "live-server --port=3000 --open=/index.html",
    "start": "node server.js",
    "dev-server": "nodemon server.js",
    "serve": "live-server --port=3000",
    "format": "prettier --write \"**/*.{js,html,css}\"",
    "format:check": "prettier --check \"**/*.{js,html,css}\""
  },
  "keywords": [
    "chess",
    "web",
    "game",
    "multiplayer",
    "online"
  ],
  "author": "Your Name",
  "license": "AGPL-3.0",
  "dependencies": {
    "chess.js": "^0.12.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "nodemon": "^3.0.2",
    "prettier": "^3.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
